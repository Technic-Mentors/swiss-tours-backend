# Server
PORT=3010
NODE_ENV=development

# Public base URL of THIS api (used for sitemap + absolute image urls)
PUBLIC_URL=http://localhost:3010

# Frontend origin allowed by CORS (comma separated for more than one)
CORS_ORIGIN=http://localhost:5173

# Public site URL (used for sitemap <loc> and canonical tags)
SITE_URL=http://localhost:5173

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root1234
DB_NAME=swiss_tour_transfer

# Auth
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=8h

# ---------------------------------------------------------------------
# Email notifications for new enquiries (optional)
#
# 1. Turn on 2-Step Verification on the Google account
# 2. Google Account -> Security -> App passwords -> generate one
# 3. Paste the address and the 16-character code below (spaces are fine)
#
# Leave empty to turn email off. Enquiries are still saved either way.
# ---------------------------------------------------------------------
GMAIL_USER=
GMAIL_APP_PASSWORD=
